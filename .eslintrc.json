{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb",
    "airbnb/hooks",
    "airbnb-typescript",
    "prettier",
    "plugin:@cspell/recommended",
    "plugin:jsx-a11y/recommended",
    "plugin:storybook/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "project": "tsconfig.eslint.json"
  },
  "plugins": ["@typescript-eslint", "prettier", "jsx-a11y"],
  "settings": {
    // Lint imported primitives as the element they render. Only `CioButton` is mapped:
    // this repo's own `Button` wrapper takes its text via a `label` prop, which
    // jsx-a11y cannot see, so mapping it would flag every correct call site.
    "jsx-a11y": {
      "components": {
        "CioButton": "button"
      }
    }
  },
  "rules": {
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    // Scrollable regions must be keyboard focusable (WCAG 2.1.1), so allow
    // tabIndex on the roles we use for scroll containers.
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      { "tags": [], "roles": ["log"], "allowExpressionValues": true }
    ],
    "react/require-default-props": "off",
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off",
    "prefer-const": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "prettier/prettier": ["error"],
    "global-require": "off",
    "max-len": [
      "error",
      120,
      2,
      {
        "ignoreUrls": true,
        "ignoreComments": false,
        "ignoreRegExpLiterals": true,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true
      }
    ],
    "object-curly-newline": "off",
    "padded-blocks": "off",
    "react/prefer-stateless-function": "off",
    "max-depth": ["error", 4],
    "max-nested-callbacks": ["error", 5],
    "max-params": ["error", 4],
    "complexity": ["error", 20],
    "@cspell/spellchecker": ["error"],
    "react/jsx-props-no-spreading": "off",
    "react/jsx-no-useless-fragment": [2, { "allowExpressions": true }],
    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/stories/**/*.*",
          "**/.storybook/**/*.*",
          "spec/**/*.*",
          "**/*.test.*",
          "**/*.server.test.*"
        ],
        "peerDependencies": true
      }
    ]
  },
  "overrides": [
    {
      "files": "tests/**/*.ts",
      "env": {
        "node": true,
        "jest": true
      }
    },
    {
      "files": "spec/**/*.jsx",
      "rules": {
        "react/prop-types": "off"
      }
    },
    {
      // Test setup legitimately declares several stateless stub classes
      // (ResizeObserver, IntersectionObserver) and patches console.
      "files": ["spec/setupTests.ts", "spec/setupTests.server.ts"],
      "rules": {
        "max-classes-per-file": "off",
        "class-methods-use-this": "off",
        "no-console": "off"
      }
    },
    {
      "files": "**/stories/**/*.*",
      "rules": {
        "no-alert": "off"
      }
    }
  ],
  "ignorePatterns": ["*.config.js", "lib/**/*.js", "lib/**/*.d.ts", "docs/**/*.js"]
}
