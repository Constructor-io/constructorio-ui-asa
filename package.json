{
  "name": "@constructor-io/constructorio-ui-asa",
  "version": "0.0.1",
  "description": "Constructor.io AI Shopping Agent UI library for web applications",
  "author": "constructor.io",
  "license": "MIT",
  "homepage": "https://github.com/Constructor-io/constructorio-ui-asa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constructor-io/constructorio-ui-asa.git"
  },
  "bugs": {
    "url": "https://github.com/Constructor-io/constructorio-ui-asa/issues"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./styles.css": {
      "import": "./lib/mjs/styles.css",
      "require": "./lib/cjs/styles.css"
    },
    "./components/Chat/styles.css": {
      "import": "./lib/mjs/components/Chat/Chat.css",
      "require": "./lib/cjs/components/Chat/Chat.css"
    },
    "./components/ResultsBlock/styles.css": {
      "import": "./lib/mjs/components/ResultsBlock/ResultsBlock.css",
      "require": "./lib/cjs/components/ResultsBlock/ResultsBlock.css"
    },
    "./constructorio-ui-asa-bundled": {
      "import": "./dist/constructorio-ui-asa-bundled.js",
      "require": "./dist/constructorio-ui-asa-bundled.js"
    },
    "./cjs": {
      "import": "./lib/cjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "dist/constructorio-ui-asa-bundled.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "types": "lib/types/index.d.ts",
  "scripts": {
    "lint": "eslint src --ext js,ts,jsx,tsx",
    "check-types": "npx tsc --noEmit -p tsconfig.check.json",
    "copy-styles": "rsync -am --include='*/' --include='*.css' --exclude='*' src/ lib/mjs/ && rsync -am --include='*/' --include='*.css' --exclude='*' src/ lib/cjs/",
    "dev": "storybook dev -p 6006",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook:ci": "storybook dev --ci --quiet -p 6006",
    "test-storybook": "test-storybook",
    "test-storybook:watch": "test-storybook --watch",
    "test-storybook:ci": "start-server-and-test storybook:ci http://localhost:6006 test-storybook",
    "build-storybook": "storybook build --docs -o 'docs'",
    "storybook-docs-dev": "storybook dev --docs -p 6007",
    "serve-built-storybook": "npx http-server docs",
    "version": "npm run build-storybook && git add -u ./docs && git add ./docs/* && npm run compile",
    "compile": "node ./src/generateVersion.js && rm -rf lib && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && npm run copy-styles && vite build",
    "check-license": "license-checker --production --onlyAllow 'Apache-2.0;BSD-3-Clause;MIT;0BSD;BSD-2-Clause' --excludePackages 'picocolors@1.0.0'",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "@constructor-io/constructorio-client-javascript": "^2.88.0",
    "@constructor-io/constructorio-ui-components": "^1.6.0",
    "react": ">=16.12.0",
    "react-dom": ">=16.12.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.7.0",
    "@constructor-io/constructorio-client-javascript": "^2.88.0",
    "@constructor-io/constructorio-ui-components": "^1.6.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@cspell/eslint-plugin": "^6.18.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-mdx-gfm": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/react-webpack5": "^8.6.14",
    "@storybook/test-runner": "^0.22.1",
    "@storybook/testing-library": "^0.2.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.8",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "chromatic": "^10.0.0",
    "eslint": "^8.30.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.13",
    "husky": "^8.0.0",
    "jest": "^28.1.3",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "license-checker": "^25.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "start-server-and-test": "^2.0.3",
    "storybook": "^8.6.17",
    "typescript": "^4.9.4",
    "vite": "^6.4.1",
    "vite-plugin-css-injected-by-js": "^3.1.0",
    "webpack": "^5.105.4"
  },
  "dependencies": {},
  "overrides": {
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "minimatch@9": "9.0.9",
    "form-data": "4.0.6",
    "joi": "17.13.4",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "postcss": "8.5.24",
    "uuid": "11.1.1",
    "yaml": "1.10.3"
  },
  "volta": {
    "node": "22.18.0",
    "npm": "10.9.3"
  }
}
